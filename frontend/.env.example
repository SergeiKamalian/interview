VITE_GRAPHQL_URL=/graphql
VITE_API_URL=
VITE_APP_NAME=AI Interviewer
# Set to false for text-only interview QA (no TTS playback).
VITE_INTERVIEW_AUDIO_ENABLED=true
# Loading/thinking sound while AI analyzes the answer (off by default).
VITE_INTERVIEW_THINKING_SOUND_ENABLED=false
# true — демо KPI и график на /dashboard; false — данные из API
VITE_DASHBOARD_MOCK=false
