# Application
NODE_ENV=development
PORT=3000

# MySQL (совпадает с корневым .env.example / docker-compose)
MYSQL_HOST=localhost
MYSQL_PORT=3322
MYSQL_USER=ai_interviewer
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=ai_interviewer
MYSQL_ROOT_PASSWORD=root

# Redis
REDIS_HOST=localhost
REDIS_PORT=6392
# REDIS_PASSWORD=

# Auth (block 04)
JWT_SECRET=local-dev-secret-change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# AI provider (block 07) — OpenAI compatible API
AI_PROVIDER=openai
AI_API_KEY=local-dev-ai-key-replace-me
AI_MODEL_EVALUATION=gpt-5.4-nano
# Model routing per role (TASK-17.1). All optional; default = AI_MODEL_EVALUATION.
# Strong/reasoning model → checkpoint evaluator (uses AI_MODEL_EVALUATION) + final summary.
# Cheap/fast model → classifier, scoring gate, follow-up planner, interviewer voice/opener.
# AI_MODEL_FINAL=        # role: final evaluation summary (strong model)
# AI_MODEL_CLASSIFIER=   # role: candidate-turn classifier + topic-opener scoring gate (cheap)
# AI_MODEL_FOLLOW_UP=    # role: follow-up planner (cheap)
# AI_MODEL_VOICE=        # role: interviewer voice / question opener+reveal (cheap)
AI_TIMEOUT_MS=30000
# AI_BASE_URL=https://api.openai.com/v1
# AI_PRICE_INPUT_PER_1K=0.00015
# AI_PRICE_OUTPUT_PER_1K=0.0006
# SCORE_THRESHOLD_WEAK=40
# SCORE_THRESHOLD_BASIC=55
# SCORE_THRESHOLD_AVERAGE=70
# SCORE_THRESHOLD_GOOD=85
# AI_MAX_RETRIES=2
# AI_TEMPERATURE=0

# Adaptive interview (block 09)
ADAPTIVE_INTERVIEW_ENABLED=true
FRONTEND_ORIGIN=http://localhost:5174
ADAPTIVE_AI_DEBUG=false
ADAPTIVE_AI_MESSAGE_STREAMING=true
ADAPTIVE_FOLLOW_UP_USE_LLM=true
ADAPTIVE_MAX_FOLLOW_UPS_PER_QUESTION=4
ADAPTIVE_MAX_FOLLOW_UPS_PER_CHECKPOINT=1
ADAPTIVE_MAX_FOLLOW_UPS_HEAVY_CHECKPOINT=2
ADAPTIVE_HEAVY_CHECKPOINT_WEIGHT_RATIO=0.2
ADAPTIVE_MIN_PRIORITY_TO_PROBE=0.15
ADAPTIVE_LOCAL_TURN_LIMIT=10
# TASK-17.5: max chars of a candidate answer passed to the evaluator (full answer, no truncation).
ADAPTIVE_MAX_CANDIDATE_ANSWER_LENGTH=8000
ADAPTIVE_QUESTION_SCORE_SUFFICIENT_RATIO=0.85
FOLLOW_UP_SCORE_DELTA_CAP=0.25
FOLLOW_UP_MAX_RELATIVE_BOOST=0.5
FOLLOW_UP_STAGNATION_LIMIT=2
PER_TURN_EVAL_PROMPT_VERSION=2.5.0
ADAPTIVE_LOW_WEIGHT_CHECKPOINT_RATIO=0.2
# Legacy Chat Completions fallback: keeps Redis messages and sends full chat history.
ADAPTIVE_AI_CONVERSATION_SESSION=true
# Single LLM call: evaluate + suggested follow-up (skips second planner call when valid)
ADAPTIVE_AI_COMBINED_TURN=true
ADAPTIVE_AI_CONVERSATION_TTL_SECONDS=86400
# Recommended default: OpenAI Responses API server-side state (send only new turns after bootstrap)
ADAPTIVE_AI_OPENAI_RESPONSES_API=true
ADAPTIVE_AI_OPENAI_SERVER_STATE=true
ADAPTIVE_AI_OPENAI_SERVER_STATE_FALLBACK=true
ADAPTIVE_AI_OPENAI_STATE_TTL_SECONDS=86400
# Emergency only: regex intent when CandidateTurnClassifier AI is down (default off)
# CLASSIFIER_REGEX_EMERGENCY_FALLBACK=false

# Optional
GRAPHQL_PLAYGROUND=true
# LOG_LEVEL=log

# ElevenLabs TTS (block 10 voice)
ELEVENLABS_TTS_ENABLED=false
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_TTS_MODEL_ID=eleven_flash_v2_5
# ELEVENLABS_TTS_OUTPUT_FORMAT=mp3_44100_128
# ELEVENLABS_TTS_OPTIMIZE_LATENCY=3
# ELEVENLABS_TTS_MAX_TEXT_LENGTH=2000
# Quote required (spaces / special chars) when dev-local.sh sources this file.
# Ellipsis adds hesitation; backend also inserts <break time="..."/> between parts.
# Cached mp3: backend/storage/media/system/thinking-{hash}.mp3 (new hash → new file on next request).
# After changing phrase/voice: restart backend + hard-refresh browser (Cmd+Shift+R).
# ELEVENLABS_THINKING_PHRASE="Хмм... хорошо..."
# Estimated TTS cost for analytics (USD per 1000 characters).
# ELEVENLABS_PRICE_PER_1K_CHARS=0.06

# Media storage (block 10 voice)
MEDIA_STORAGE_LOCAL_DIR=storage/media
# MEDIA_AUDIO_MAX_BYTES=10485760
# MEDIA_AUDIO_MAX_DURATION_SEC=180
