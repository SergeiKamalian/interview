# Application
NODE_ENV=development
PORT=3000

# MySQL (совпадает с корневым .env.example / docker-compose)
MYSQL_HOST=localhost
MYSQL_PORT=3322
MYSQL_USER=ai_interviewer
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=ai_interviewer
MYSQL_ROOT_PASSWORD=root

# Redis
REDIS_HOST=localhost
REDIS_PORT=6392
# REDIS_PASSWORD=

# Auth (block 04)
JWT_SECRET=local-dev-secret-change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# AI provider (block 07) — OpenAI Chat Completions
AI_PROVIDER=openai
AI_API_KEY=local-dev-ai-key-replace-me
AI_MODEL_EVALUATION=gpt-4o-mini
AI_TIMEOUT_MS=30000
# AI_BASE_URL=https://api.openai.com/v1
# AI_PRICE_INPUT_PER_1K=0.00015
# AI_PRICE_OUTPUT_PER_1K=0.0006
# SCORE_THRESHOLD_WEAK=40
# SCORE_THRESHOLD_BASIC=55
# SCORE_THRESHOLD_AVERAGE=70
# SCORE_THRESHOLD_GOOD=85
# AI_MAX_RETRIES=2
# AI_TEMPERATURE=0

# Optional
GRAPHQL_PLAYGROUND=true
# LOG_LEVEL=log
