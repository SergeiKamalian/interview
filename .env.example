# Application
NODE_ENV=development
PORT=3000
FRONTEND_PORT=5174

# Docker Compose isolation (must not conflict with captcha-back)
COMPOSE_PROJECT_NAME=ai-interviewer-local

# MySQL (docker-compose + backend)
MYSQL_HOST=localhost
MYSQL_PORT=3322
MYSQL_USER=ai_interviewer
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=ai_interviewer
MYSQL_ROOT_PASSWORD=root

# Redis
REDIS_HOST=localhost
REDIS_PORT=6392

# Auth placeholder (block 04)
JWT_SECRET=local-dev-secret-change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=7d

# AI provider (block 07)
AI_PROVIDER=openai
AI_API_KEY=local-dev-ai-key-replace-me
AI_MODEL_EVALUATION=gpt-5.4-nano
AI_TIMEOUT_MS=30000

# Adaptive interview (block 09) — backend reads from backend/.env; listed here for docker-compose reference
# ADAPTIVE_INTERVIEW_ENABLED=true
# FRONTEND_ORIGIN=http://localhost:5174
# ADAPTIVE_AI_DEBUG=false
# ADAPTIVE_AI_MESSAGE_STREAMING=true
# ADAPTIVE_FOLLOW_UP_USE_LLM=true
# ADAPTIVE_MAX_FOLLOW_UPS_PER_QUESTION=3
# ADAPTIVE_MAX_FOLLOW_UPS_PER_CHECKPOINT=1
# ADAPTIVE_LOCAL_TURN_LIMIT=10
# ADAPTIVE_QUESTION_SCORE_SUFFICIENT_RATIO=1
# ADAPTIVE_LOW_WEIGHT_CHECKPOINT_RATIO=0.2
# Legacy Chat Completions fallback: keeps Redis messages and sends full chat history.
# ADAPTIVE_AI_CONVERSATION_SESSION=true
# ADAPTIVE_AI_COMBINED_TURN=true
# ADAPTIVE_AI_CONVERSATION_TTL_SECONDS=86400
# Recommended default: OpenAI Responses API + previous_response_id per question.
# ADAPTIVE_AI_OPENAI_RESPONSES_API=true
# ADAPTIVE_AI_OPENAI_SERVER_STATE=true
# ADAPTIVE_AI_OPENAI_SERVER_STATE_FALLBACK=true
# ADAPTIVE_AI_OPENAI_STATE_TTL_SECONDS=86400

# Optional
GRAPHQL_PLAYGROUND=true
# LOG_LEVEL=log

# ElevenLabs TTS (block 10 voice) — backend reads from backend/.env
# ELEVENLABS_TTS_ENABLED=false
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_TTS_MODEL_ID=eleven_flash_v2_5
# ELEVENLABS_TTS_OUTPUT_FORMAT=mp3_44100_128
# ELEVENLABS_TTS_OPTIMIZE_LATENCY=3
# ELEVENLABS_TTS_MAX_TEXT_LENGTH=2000
